// Prisma MongoDB foundation for take-seat.
// MongoDB support is pinned to Prisma ORM 6.19.x until official Prisma v7
// MongoDB support is available.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum MeetingSessionStatus {
  draft
  scheduled
  live
  completed
  archived
  canceled
}

enum SeatMapStatus {
  draft
  published
  archived
}

enum SeatKind {
  host_team
  sound
  duty
  guest
  host
  member
  proxy
  empty
  reserved
}

enum SeatAssignmentStatus {
  assigned
  checked_in
  absent
  canceled
  released
  reserved
}

enum OperationActorRole {
  system
  admin
  staff
  member
  import
}

enum PublicEventStatus {
  draft
  preview
  published
  live
  completed
  archived
  hidden
}

enum LivePollType {
  single_choice
  multiple_choice
}

enum LivePollStatus {
  draft
  open
  closed
  archived
}

enum LivePollEligibility {
  public
  code_required
  signed_in_member
}

enum LivePollResultVisibility {
  hidden
  after_closed
  live_public
  admin_only
}

model MeetingSession {
  id           String               @id @default(auto()) @map("_id") @db.ObjectId
  weekId       String               @unique
  date         DateTime
  title        String
  chapterName  String
  meetingLabel String
  source       String               @default("seed")
  status       MeetingSessionStatus @default(draft)
  publicSlug   String?              @unique
  publicStatus PublicEventStatus    @default(draft)
  publicConfig Json?
  // Optional on purpose: existing documents have no value (null = weekly_meeting).
  eventType    String?
  location     String?
  startsAt     String?
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  seatMaps      SeatMap[]
  operationLogs OperationLog[]
  livePolls     LivePoll[]
  participations Participation[]
  gifts         Gift[]
  seatPlan      EventSeatPlan?

  @@index([date])
  @@index([status])
  @@index([publicStatus])
}

model Member {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  displayName String   @unique
  adminGroup  String?
  roles       String[]
  note        String?
  isActive    Boolean  @default(true)
  industry    String?
  company     String?
  phone       String?
  email       String?
  intro       String?
  targetCustomers String?
  aliases     String[]
  // 'member' = chapter member. Null = name created from a seat map (guest, proxy, unknown).
  category    String?
  joinedAt    DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments SeatAssignment[]
  pollOptions  LivePollOption[]
  participations Participation[]
  roleTerms    RoleTerm[]
  palmsRows    PalmsMemberRow[]

  @@index([isActive])
}

model SeatMap {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  sessionId      String        @db.ObjectId
  session        MeetingSession @relation(fields: [sessionId], references: [id])
  title          String
  version        Int           @default(1)
  status         SeatMapStatus @default(draft)
  layoutKind     String        @default("bni-weekly-grid")
  topRoles       Json
  memberRoster   String[]
  heroes         String[]
  industryChains Json?
  source         String        @default("seed")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  seats       Seat[]
  assignments SeatAssignment[]
  revisions   SeatMapRevision[]

  @@index([sessionId])
  @@index([status])
}

model SeatTemplate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String   @unique
  description     String?
  layoutKind      String   @default("bni-weekly-grid")
  topRoles        Json
  items           Json
  memberRoster    String[]
  heroes          String[]
  industryChains  Json?
  sourceWeekId    String?
  sourceSeatMapId String?
  isActive        Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([sourceWeekId])
}

model Seat {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  seatMapId String   @db.ObjectId
  seatMap   SeatMap  @relation(fields: [seatMapId], references: [id])
  seatKey   String
  row       Int?
  col       Int?
  zone      String   @default("main")
  position  Int
  kind      SeatKind @default(empty)
  label     String?
  capacity  Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments SeatAssignment[]

  @@unique([seatMapId, seatKey])
  @@index([seatMapId, row, col])
  @@index([kind])
}

model SeatAssignment {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  seatMapId   String               @db.ObjectId
  seatMap     SeatMap              @relation(fields: [seatMapId], references: [id])
  seatId      String               @db.ObjectId
  seat        Seat                 @relation(fields: [seatId], references: [id])
  memberId    String?              @db.ObjectId
  member      Member?              @relation(fields: [memberId], references: [id])
  displayName String
  role        String?
  guestNumber String?
  hostFor     String?
  status      SeatAssignmentStatus @default(assigned)
  headcount   Int                  @default(1)
  source      String               @default("seed")
  metadata    Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([seatMapId])
  @@index([seatId])
  @@index([memberId])
  @@index([status])
}

model SeatMapRevision {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  seatMapId         String   @db.ObjectId
  seatMap           SeatMap  @relation(fields: [seatMapId], references: [id])
  version           Int
  snapshot          Json
  validationSummary Json?
  createdBy         String?
  reason            String?
  createdAt         DateTime @default(now())

  @@unique([seatMapId, version])
  @@index([seatMapId])
}

model OperationLog {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  sessionId   String?            @db.ObjectId
  session     MeetingSession?    @relation(fields: [sessionId], references: [id])
  actorRole   OperationActorRole @default(system)
  actorName   String?
  action      String
  targetType  String
  targetId    String?
  reason      String?
  metadata    Json?
  createdAt   DateTime           @default(now())

  @@index([sessionId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

model LivePoll {
  id               String                   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId        String                   @db.ObjectId
  session          MeetingSession           @relation(fields: [sessionId], references: [id])
  title            String
  description      String?
  type             LivePollType             @default(single_choice)
  status           LivePollStatus           @default(draft)
  eligibility      LivePollEligibility      @default(code_required)
  resultVisibility LivePollResultVisibility @default(after_closed)
  voteCodeHash     String?
  opensAt          DateTime?
  closesAt         DateTime?
  metadata         Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  options LivePollOption[]
  votes   LivePollVote[]

  @@index([sessionId])
  @@index([status])
  @@index([eligibility])
}

model LivePollOption {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  pollId            String         @db.ObjectId
  poll              LivePoll       @relation(fields: [pollId], references: [id])
  memberId          String?        @db.ObjectId
  member            Member?        @relation(fields: [memberId], references: [id])
  label             String
  publicDescription String?
  position          Int
  isActive          Boolean        @default(true)
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  votes LivePollVote[]

  @@index([pollId])
  @@index([memberId])
  @@index([isActive])
}

model LivePollVote {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  pollId             String         @db.ObjectId
  poll               LivePoll       @relation(fields: [pollId], references: [id])
  optionId           String         @db.ObjectId
  option             LivePollOption @relation(fields: [optionId], references: [id])
  tokenHash          String
  anonymousVoterHash String?
  comment            String?
  metadata           Json?
  submittedAt        DateTime       @default(now())

  @@unique([pollId, tokenHash])
  @@index([pollId])
  @@index([optionId])
  @@index([submittedAt])
}

model Asset {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  provider    String   @default("r2")
  bucket      String
  key         String
  contentType String
  byteSize    Int?
  checksum    String?
  visibility  String   @default("private")
  purpose     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bucket, key])
  @@index([purpose])
  @@index([visibility])
}

// ---------------------------------------------------------------------------
// Chamber toolbox (PLN-005). All models below are additive.
// ---------------------------------------------------------------------------

enum ParticipationKind {
  member
  guest
}

enum ParticipationStatus {
  expected
  present
  late
  absent
  medical
  substitute
}

// Event x person. Single source of truth for attendance intent and check-in.
// `key` is "m:<memberId>" for members and "g:<random>" for guests so the
// compound unique index never has to hold a null.
model Participation {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  sessionId        String              @db.ObjectId
  session          MeetingSession      @relation(fields: [sessionId], references: [id])
  key              String
  kind             ParticipationKind   @default(member)
  memberId         String?             @db.ObjectId
  member           Member?             @relation(fields: [memberId], references: [id])
  displayName      String
  status           ParticipationStatus @default(expected)
  substituteName   String?
  substituteArrivedAt DateTime?
  intentSource     String?
  intentAt         DateTime?
  checkedInAt      DateTime?
  checkInMethod    String?
  guestIndustry    String?
  guestCompany     String?
  hostMemberId     String?             @db.ObjectId
  invitedByMemberId String?            @db.ObjectId
  note             String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([sessionId, key])
  @@index([sessionId, status])
  @@index([memberId])
}

model RoleTerm {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String    @db.ObjectId
  member    Member    @relation(fields: [memberId], references: [id])
  role      String
  startsAt  DateTime
  endsAt    DateTime?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([memberId])
  @@index([role])
}

model Gift {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  sessionId     String         @db.ObjectId
  session       MeetingSession @relation(fields: [sessionId], references: [id])
  name          String
  quantity      Int            @default(1)
  donorMemberId String?        @db.ObjectId
  donorName     String?
  note          String?
  position      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  awards GiftAward[]

  @@index([sessionId])
}

model GiftAward {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  giftId                String   @db.ObjectId
  gift                  Gift     @relation(fields: [giftId], references: [id])
  winnerParticipationId String?  @db.ObjectId
  winnerName            String
  winnerKind            String?
  method                String   @default("random")
  status                String   @default("awarded")
  poolSize              Int?
  seed                  String?
  note                  String?
  editedBy              String?
  drawnAt               DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([giftId])
  @@index([status])
}

model PalmsPeriod {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  from        DateTime
  to          DateTime
  chapterName String?
  exportedAt  DateTime?
  exportedBy  String?
  isPartial   Boolean  @default(false)
  version     Int      @default(1)
  isCurrent   Boolean  @default(true)
  meetingCount Int     @default(0)
  fileName    String?
  totals      Json?
  importedBy  String?
  createdAt   DateTime @default(now())

  rows PalmsMemberRow[]

  @@index([from, to])
  @@index([isCurrent])
}

model PalmsMemberRow {
  id                       String      @id @default(auto()) @map("_id") @db.ObjectId
  periodId                 String      @db.ObjectId
  period                   PalmsPeriod @relation(fields: [periodId], references: [id])
  memberId                 String?     @db.ObjectId
  member                   Member?     @relation(fields: [memberId], references: [id])
  rawName                  String
  present                  Int         @default(0)
  absent                   Int         @default(0)
  late                     Int         @default(0)
  medical                  Int         @default(0)
  substitute               Int         @default(0)
  referralsGivenInside     Int         @default(0)
  referralsGivenOutside    Int         @default(0)
  referralsReceivedInside  Int         @default(0)
  referralsReceivedOutside Int         @default(0)
  visitors                 Int         @default(0)
  oneToOnes                Float       @default(0)
  tyfcb                    Float       @default(0)
  ceu                      Int         @default(0)

  @@index([periodId])
  @@index([memberId])
}

model ScoringRule {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  version   Int      @unique
  name      String
  isActive  Boolean  @default(false)
  config    Json
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Venue {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  address   String?
  widthM    Float    @default(20)
  heightM   Float    @default(14)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  layouts VenueLayout[]
}

model VenueLayout {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  venueId   String   @db.ObjectId
  venue     Venue    @relation(fields: [venueId], references: [id])
  name      String
  kind      String   @default("custom")
  objects   Json
  seatCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

// Spatial seat plan of one event: a snapshot of a layout plus who sits where.
model EventSeatPlan {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  sessionId   String         @unique @db.ObjectId
  session     MeetingSession @relation(fields: [sessionId], references: [id])
  layoutId    String?        @db.ObjectId
  venueName   String?
  widthM      Float          @default(20)
  heightM     Float          @default(14)
  objects     Json
  assignments Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
